# Example Nginx site for the Voice Web Bridge browser page.
#
# Serves the static page from this directory and proxies the WebSocket to the
# plugin's embedded server (web.host / web.port in plugins/voice-web-bridge/config.yml,
# defaults: 127.0.0.1:8090).
#
# Adapt: server_name, TLS certificate paths, and the root/alias to this folder.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bla-bla.com;

    # --- TLS (required: getUserMedia only works on https) ---
    ssl_certificate     /etc/letsencrypt/live/bla-bla.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bla-bla.com/privkey.pem;

    # --- Static page + vendored assets ---
    # Example with root pointing at the webpage/ directory of this project:
    root /srv/voice-web-bridge/webpage;
    index voicechat.html;

    location /lib/ {
        # Vendored opus-recorder and Pixelify Sans font assets (served same-origin — workers require it)
        try_files $uri =404;
    }

    location ~* ^/(voicechat\.html|app\.js|styles\.css)$ {
        try_files $uri =404;
    }

    # --- WebSocket proxy to the plugin ---
    location /voice-ws {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # Long-lived voice connections
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
